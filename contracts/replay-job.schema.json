{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "replay-job.schema.json",
  "title": "Replay job",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "start", "arm", "model", "reruns", "stop_mode", "budget_credits"],
  "properties": {
    "job_id": { "type": "string", "minLength": 1 },
    "start": {
      "enum": ["checkpoint", "step0"],
      "description": "checkpoint rewinds a recorded session to each tool_call_id, and its results are diagnosis. step0 runs each task fresh with the arm installed, and its results are final."
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "description": "session_id of the trace to replay. checkpoint only."
    },
    "tool_call_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Checkpoints to restore, by tool_call_id from the trace. Rewind targets the message_id on that step. checkpoint only."
    },
    "task_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "SWE-bench instance ids to run fresh. step0 only."
    },
    "arm": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "control" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": { "const": "hint" },
            "text": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "candidate" },
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Portable path such as analysis/proposals/block-test-edits."
            }
          }
        }
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Model id passed to Droid for every trial in this job."
    },
    "reruns": { "type": "integer", "minimum": 1 },
    "stop_mode": {
      "enum": ["next_user_turn", "reuse_reply", "simulated_user"]
    },
    "budget_credits": {
      "type": "number",
      "minimum": 0,
      "description": "Cap on tokenUsage.factoryCredits for this job. Cal Hacks has posted no hacker spending allotment. The Factory track prize is $2,000 cash, Factory credits, and swag, with no credit quantity."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "start": { "const": "checkpoint" } } },
      "then": { "required": ["session_id", "tool_call_ids"], "not": { "required": ["task_ids"] } }
    },
    {
      "if": { "properties": { "start": { "const": "step0" } } },
      "then": {
        "required": ["task_ids"],
        "not": { "anyOf": [{ "required": ["session_id"] }, { "required": ["tool_call_ids"] }] }
      }
    }
  ]
}
